# AIOS backend - Caddy reverse proxy with automatic TLS.
#
# Caddy terminates HTTPS (Let's Encrypt / ZeroSSL, auto-obtained + auto-renewed)
# and reverse-proxies public 443 traffic to the loopback-only uvicorn (aios-api on
# 127.0.0.1:8000). It is the ONLY process facing the network - Postgres, Redis, and
# the API itself all bind localhost.
#
# Install:
#   sudo apt-get install -y debian-keyring debian-archive-keyring apt-transport-https curl
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | sudo gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
#   curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' | sudo tee /etc/apt/sources.list.d/caddy-stable.list
#   sudo apt-get update && sudo apt-get install -y caddy
#
# Deploy: copy this file to /etc/caddy/Caddyfile, replace api.example.com with your
# real API hostname (its DNS A/AAAA record must already point at this VPS), then:
#   sudo systemctl reload caddy
#
# Keep the hostnames in sync with aios.env: set TRUSTED_HOSTS=api.example.com and
# API_CORS_ORIGINS=https://app.example.com so TrustedHostMiddleware + CORS match.

api.example.com {
	reverse_proxy 127.0.0.1:8000

	# Compress responses.
	encode zstd gzip

	# Baseline security headers (Caddy already sets HSTS-friendly TLS).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP for the API ORIGIN. This host serves JSON and file downloads, never
		# an application UI, so the policy is maximally restrictive: nothing may
		# execute, embed, or be embedded if a response is ever opened directly in
		# a browser. The DASHBOARD's (necessarily looser) policy is emitted by
		# Next.js itself - see frontend/next.config.mjs.
		#
		# One exception is handled in application code, not here: the audit
		# report.html download route sets its own narrower policy
		# (`REPORT_HTML_VIEW_HEADERS` in app/services/audit_artifacts.py) allowing
		# inline styles and data: images. Caddy's `header` REPLACES a header of the
		# same name, so this directive is applied only where the app did not set one.
		# `sandbox` is deliberately NOT included: this host streams PDF and JSON
		# downloads, and a bare `sandbox` would apply the most restrictive sandbox
		# to any response a browser renders inline. The substantive protections
		# here are default-src/frame-ancestors/base-uri/form-action.
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
		# Do not advertise the server software.
		-Server
	}

	# Structured access logs to journald (view: journalctl -u caddy).
	log {
		output stderr
		format json
	}
}
