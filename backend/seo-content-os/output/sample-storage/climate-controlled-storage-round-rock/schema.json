      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do you have climate units open in Round Rock right now?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The live board on our site shows current climate availability by size at the Round Rock building. Because it updates from our management software, it is accurate to the day rather than a printed rate that drifts."
          }
        },
        {
          "@type": "Question",
          "name": "Is a 10x10 climate unit big enough for a one-bedroom apartment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. A 10x10 holds a one-bedroom apartment's furniture plus about 100 boxes. If you have a two-bedroom or a lot of larger furniture, a 10x15 is the safer size."
          }
        },
        {
          "@type": "Question",
          "name": "What temperature do the climate units hold, and do they control humidity?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Round Rock climate units are held between 55 and 80 degrees, with dehumidifiers running to control humidity, not just temperature. Dana checks the thermostats weekly."
          }
        },
        {
          "@type": "Question",
          "name": "Is there really no charge for the first month?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Your first month of rent is free. A one-time $25 admin fee applies at move-in, and a protection plan or your own renters or homeowners policy is required. There is no deposit and the lease is month to month."
          }
        }
      ]
