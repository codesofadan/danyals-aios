node_modules/
**/node_modules/

# Build output
.next/
dist/
build/
out/

# Logs
*.log
npm-debug.log*

# Env / secrets
.env
.env.local
.env.*.local

# OS / editor
.DS_Store
Thumbs.db

# Stray duplicate frontend copy (build artifacts + older mirror; not authoritative)
daniyals-frontend/
tools/citation_handoffs.json
wordpress-plugin.zip
wordpress-plugin/aios-publisher.zip
# Built plugin/theme distributables, wherever they are produced. A committed zip is a
# diff nobody can read, and the root copies had gone stale in exactly the way that
# predicts: aios-publisher.zip carried plugin v1.4.0 (4 files) while source was v1.7.0
# (8 files, the whole includes/ directory missing), and the install instructions pointed
# at it. Build these; do not commit them.
/aios-publisher.zip
/spotino-theme.zip
docs/deliverables/*.txt

# Project comms / reference exports — MUST never enter the repo (SEC-017).
# The WhatsApp export was moved to ../danyals-aios-project-reference/ on 2026-08-23.
# It was never committed; this entry exists so it can never be added by accident.
whatsapp chats, media and calls/
*.opus

# Audit artifact store (AUDIT_ARTIFACT_DIR). Generated per run: report PDFs, the
# workbook and the CSV pack. Client data and megabytes of it - it belongs on the
# volume the worker writes to, never in git.
/data/

# Next.js build output from throwaway/parallel builds. `.next/` above catches the
# default dir, but `next build --distDir .next-<name>` does not match it, and two
# such dirs (.next-restructure, .next-web2demo = 219MB) reached the untracked set.
# Next also rewrites frontend/tsconfig.json to `include` their types/ on every such
# build; that edit is an artifact, not a source change - revert it, do not commit it.
.next-*/
# build artifacts
0_build.txt
logs.zip
