# AIOS backend - PRODUCTION environment template.
#
# Copy to /etc/aios/aios.env (0600 root:root), then fill it in. install.sh seeds
# this file on its first run and stops so you can edit it. systemd loads it as
# EnvironmentFile for aios-api / aios-worker / aios-beat; pydantic-settings then
# reads these from the process environment (env vars win over any stray .env).
#
# ============================ FOOTGUN (read this) ============================
# systemd EnvironmentFile does NOT strip a trailing inline `# comment` from a
# value line - `KEY=value  # note` would set KEY to "value  # note". So EVERY
# comment in this file lives on its OWN line, never after a value. Keep it that
# way when you edit. (This also sidesteps the python-dotenv blank-value footgun.)
# Multi-line PEM values are stored as ONE double-quoted line with newlines as
# literal \n; systemd un-escapes them and the app's config also restores them.
# ============================================================================
#
# ========================= WHAT IS (AND IS NOT) IN HERE ======================
# app/config.py defines ~220 settings. This file documents ~100 of them ON PURPOSE.
# A template that listed all 220 would be read by nobody, and the operator would
# lose the ones that matter in the noise. The selection criterion is:
#
#   A setting belongs in this file if LEAVING IT OUT DEGRADES THE PLATFORM
#   SILENTLY - it keeps returning 200s and keeps looking healthy while producing a
#   wrong, reduced or unsafe result that nothing in the UI or the logs names.
#
# Everything else is deliberately absent, and the absence is the documentation:
#   * REQUIRED_IN_PROD secrets fail fast at boot with the missing name (they are
#     still listed below, because you have to SET them, not because they are quiet);
#   * key-gated provider seams that report `status='degraded'` / "not configured"
#     already announce themselves in the product - the module tells you it is off;
#   * pure tuning knobs (batch sizes, beat cadences, per-call cost estimates, the
#     PRICE_* unit-price table) have correct defaults and change nothing by being
#     absent. Read app/config.py when you want to tune one.
#
# The section "SETTINGS WHOSE ABSENCE DEGRADES SILENTLY" near the bottom collects
# the ones that are ONLY here because of that criterion - each with the specific
# wrong behaviour you get by skipping it. Do not delete a line from it because it
# looks like a default you could accept; the default is the failure being described.
# ============================================================================

# --- App -------------------------------------------------------------------
# dev | prod. prod: docs off, JSON logs, fail-fast on any missing REQUIRED secret.
APP_ENV=prod
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# comma-separated origins allowed to call the API (your real dashboard host).
# In the shipped topology the browser never calls the API cross-origin (the
# dashboard proxies /api/v1 same-origin - see the DASHBOARD block below), so this
# is not load-bearing there. Keep it correct anyway: it is what a direct
# browser-to-api.example.com client would be checked against.
API_CORS_ORIGINS=https://app.example.com
# comma-separated allowed Host headers (TrustedHostMiddleware).
#
# THE 127.0.0.1 ENTRY IS NOT OPTIONAL AND NOT A DEV LEFTOVER. The dashboard's
# rewrite proxy runs with `changeOrigin: true`, so a call it forwards arrives at
# uvicorn as `Host: 127.0.0.1:8000`, never as your public API hostname. Starlette
# compares the Host header with the port stripped, so a list without `127.0.0.1`
# makes every dashboard request a 400 - while the pages themselves load perfectly,
# which is what makes it hard to diagnose. Set your real hosts, keep the loopback.
TRUSTED_HOSTS=api.example.com,app.example.com,127.0.0.1

# --- Dashboard (aios-web: the Next.js frontend) -----------------------------
# ============================ BUILD-TIME, NOT RUNTIME ========================
# BACKEND_ORIGIN and both NEXT_PUBLIC_* below are consumed by `npm run build`, NOT
# by the running server (AIOS_WEB_PORT is the one genuinely-runtime setting in this
# block). That distinction is the single most misleading thing in this file:
#   * every NEXT_PUBLIC_* is textually INLINED into the JavaScript bundle;
#   * BACKEND_ORIGIN is read by frontend/next.config.mjs and the resulting
#     /api/v1 rewrite is FROZEN into .next/routes-manifest.json.
# install.sh reads them from THIS file and exports them for the build. Changing
# one here and running `systemctl restart aios-web` therefore changes NOTHING -
# with no error, because there is nothing to error about. Re-run install.sh.
# =============================================================================
# Loopback port aios-web listens on. Also the port the Caddyfile's dashboard block
# proxies to - change both together, there is no shared source for this number.
AIOS_WEB_PORT=3000
# Where the dashboard's server-side rewrite proxy sends /api/v1/*. This is a
# LOOPBACK address on purpose: the call never leaves the box, so it costs no TLS
# handshake and cannot be intercepted. Point it elsewhere only if aios-api runs on
# a different host.
BACKEND_ORIGIN=http://127.0.0.1:8000
# LEAVE THIS BLANK unless you have read the whole note. Blank means the browser
# calls the RELATIVE `/api/v1`, which the dashboard proxies same-origin: no CORS,
# and the app's own Content-Security-Policy (`connect-src 'self'`, emitted by
# next.config.mjs) stays true without being widened.
#
# A BLANK VALUE HERE IS NOT THE SAME AS THE STRING "". lib/api.ts reads
# `process.env.NEXT_PUBLIC_API_BASE_URL ?? "/api/v1"`, and `??` does not fall back
# on an empty string - so a NEXT_PUBLIC_API_BASE_URL that is present-but-empty
# bakes `""` into the bundle and every call goes to `/audits` instead of
# `/api/v1/audits`: a dashboard that loads and does nothing. install.sh guards
# this by refusing to export a blank one; do not work around that guard.
NEXT_PUBLIC_API_BASE_URL=
# Where authenticated FILE downloads (audit report.pdf, findings.json,
# deliverables) are fetched from. Blank -> they go through the same-origin proxy,
# which WORKS but is pathologically slow on multi-MB binaries (a measured 7.5MB PDF
# took minutes through the proxy against ~5s direct), and a user reads that as a
# hung 0KB download.
#
# Setting it to https://api.example.com fixes the speed and needs TWO other changes
# that are NOT in this file, because the fetch then becomes cross-origin:
#   1. frontend/next.config.mjs: add that origin to the CSP's `connect-src`, or the
#      browser blocks every download and the app cannot even see the failure;
#   2. API_CORS_ORIGINS above must list your dashboard origin.
# Left blank here because a wrong-but-plausible value produces silently blocked
# downloads, and slow is a better default than broken. Turn it on deliberately.
NEXT_PUBLIC_FILE_BASE_URL=

# ===================== REQUIRED IN PROD (app won't boot without these) =======

# --- Local Postgres (the data plane) - two DSNs, one per trust level --------
# Both target the loopback PostgreSQL 16 `aios` DB. install.sh sets each role's
# password FROM these DSNs, so pick strong URL-safe passwords here first.
# The password sits inside a URI, so use alphanumerics (or percent-encode any
# reserved char: @ -> %40, : -> %3A, / -> %2F, # -> %23). Avoid ${...} and $ (both
# systemd and libpq treat the DSN literally, but a stray ${VAR} confuses tooling).
# authenticated-role DSN -> the per-request RLS pool (RLS APPLIES). Also used by
# db migrations apply + the RLS gate.
DATABASE_URL=postgresql://authenticated:CHANGE_ME_AUTH_PW@127.0.0.1:5432/aios
# service_role DSN -> the privileged pool (BYPASSRLS); server-only, never logged.
DATABASE_ADMIN_URL=postgresql://service_role:CHANGE_ME_SERVICE_PW@127.0.0.1:5432/aios

# --- Local auth (own EdDSA / Ed25519 JWT) ----------------------------------
# Login SIGNS a short-lived access token with the PRIVATE key; every request
# VERIFIES with the PUBLIC key under a hard ["EdDSA"] allow-list. No JWKS, no
# shared secret. Generate a fresh keypair (prints both lines ready to paste):
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as E; from cryptography.hazmat.primitives import serialization as s; k=E.generate(); pr=k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()).decode(); pu=k.public_key().public_bytes(s.Encoding.PEM,s.PublicFormat.SubjectPublicKeyInfo).decode(); print('JWT_PRIVATE_KEY=\"'+pr.replace(chr(10),'\\\\n')+'\"'); print('JWT_PUBLIC_KEY=\"'+pu.replace(chr(10),'\\\\n')+'\"')"
# API-only; NEVER commit the real key or expose it to the frontend.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...replace-me...\n-----END PUBLIC KEY-----\n"
# expected `iss` on our own tokens
LOCAL_JWT_ISSUER=aios
# expected `aud` on our own tokens
JWT_AUDIENCE=authenticated
# Access-token lifetime, in seconds. 604800 = 7 days, and this is NOT a knob to
# tighten casually: there is no refresh route, so this value IS the whole session.
# This template previously shipped 3600, which meant every deploy that followed it
# logged its staff and clients out ONE HOUR into a working day, mid-task, with no
# explanation beyond a bounce to /login - the exact failure app/config.py's own
# comment warns about. Shorten it only alongside a refresh path.
JWT_ACCESS_TTL_SECONDS=604800

# --- Vault (app-layer AES-256-GCM) -----------------------------------------
# base64-encoded 32-byte master key; lives ONLY here, NEVER in Postgres. Rotating
# it means RE-SEALING every stored secret; losing it makes them unrecoverable.
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES

# ===================== OPERATIONAL (sane defaults; adjust as needed) =========

# --- Redis (app cache + readiness) and Celery (separate logical DBs) --------
# INVARIANT #7: app cache on /0, Celery broker on /1, results on /2, so a cache
# FLUSHDB can never wipe queued jobs.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# --- Seed owner (first login; used once by install.sh, then inert) ----------
# provision_owner mints the first OWNER (super template = all features) from these.
# Idempotent. Keep the password strong; it is never logged.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Agency Owner

# --- Tuning ----------------------------------------------------------------
# hard per-dependency ceiling for /health/ready
READINESS_TIMEOUT_SECONDS=3

# ===================== OPTIONAL PROVIDER KEYS (key-gated modules) ============
# Every block below is OPTIONAL: the module ships + unit-tests on deterministic
# fakes and ACTIVATES when its key lands (a keyless deploy degrades gracefully,
# it never crashes). Fill a block only when you have that provider's credential.

# --- Audit engine (Module 01) - a SEPARATE product, its OWN interpreter -----
# repo root of danyals-audit-system (subprocess, never imported here)
AUDIT_ENGINE_DIR=
# interpreter inside that repo's venv
AUDIT_ENGINE_PYTHON=
# Headless-browser cache used to render the report.pdf (Playwright Chromium).
# install.sh downloads Chromium here and the worker unit exports the same path, so
# the engine subprocess finds it. Leave as-is unless you relocate /var/lib/aios.
PLAYWRIGHT_BROWSERS_PATH=/var/lib/aios/ms-playwright
# worker-owned hard timeout per run (< the Celery task_time_limit of 1800)
AUDIT_TIMEOUT_SECONDS=1500
AUDIT_MAX_PAGES=100
AUDIT_PROFILE=general
# engine reports no spend; a Paid run logs this estimate via the cost path
AUDIT_PAID_COST_ESTIMATE=1.5
# controlled root for stored report PDFs + findings.json (keep under /var/lib/aios
# so the worker's StateDirectory covers it); blank = downloads disabled
AUDIT_ARTIFACT_DIR=/var/lib/aios/artifacts/audits
# Fiverr upsell link on the PUBLIC free-audit report (not a secret)
FIVERR_UPSELL_URL=https://www.fiverr.com/iamdaani

# --- Context / AI-memory (P6B): Anthropic summarizer + Voyage embedder + Pinecone
# Anthropic (summarizer). Anthropic has NO embeddings API - the embedder is separate.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SUMMARY=claude-haiku-4-5
ANTHROPIC_MODEL_HEAVY=claude-sonnet-5
# Embedder. EMBEDDINGS_PROVIDER=voyage (Voyage AI, default) OR openai (OpenAI
# /v1/embeddings; for an OpenAI-only client -> set EMBEDDINGS_MODEL=text-embedding-3-small).
# EMBEDDINGS_DIM MUST match the Pinecone index dimension (OpenAI pins output to it).
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3
EMBEDDINGS_DIM=1024
# Vector store (Pinecone; namespaced per entity). Index dim MUST equal EMBEDDINGS_DIM.
PINECONE_API_KEY=
PINECONE_INDEX=
# optional index host override (blank -> resolved by name)
PINECONE_HOST=
CONTEXT_DEBOUNCE_SECONDS=30
CONTEXT_SUMMARY_TOKEN_BUDGET=1200
CONTEXT_TOPK=6
CONTEXT_MAX_FACTS=64
CONTEXT_BACKOFF_SECONDS=300
CONTEXT_DISPATCH_BATCH=100
# reconcile sweep cadence (seconds); safety net, runs rarely
CONTEXT_RECONCILE_SECONDS=3600
# turn the reconcile sweep from a detector into a self-healer (default off)
CONTEXT_RECONCILE_REPAIR=false
CONTEXT_SUMMARIZE_COST_ESTIMATE=0.02
CONTEXT_EMBED_COST_ESTIMATE=0.001
# NOTE: the context provider SDKs are the [ai] extra - install them on the box
# once these keys land:  sudo -u aios /opt/aios/backend/.venv/bin/pip install -e '.[ai]'

# --- Content module (P7A): Serper SERP research + image generation ----------
SERPER_API_KEY=
IMAGE_GEN_API_KEY=
# Keep this in step with app/config.py's default. It read `gpt-image-1` here while
# the code had moved to `gpt-image-2`, and because this file is loaded as an
# EnvironmentFile the stale template value SILENTLY WON on every deploy - the
# platform generated against a superseded model and reported nothing unusual. An
# env template that overrides a code default is not neutral documentation.
IMAGE_GEN_MODEL=gpt-image-2
# Generated hero/section images must be LANDSCAPE: the page layouts are wide, and a
# square image does not error, it just breaks the design of every page it lands in.
IMAGE_GEN_SIZE=1536x1024
CONTENT_RESEARCH_COST_ESTIMATE=0.01
CONTENT_GENERATE_COST_ESTIMATE=0.15
CONTENT_RESEARCH_NEUTRAL_DA=30.0
CONTENT_RESEARCH_WINNABLE_STRETCH=15.0
CONTENT_RESEARCH_CACHE_TTL_SECONDS=86400
CONTENT_TEARDOWN_TIMEOUT_SECONDS=8.0
CONTENT_TEARDOWN_MAX_PAGES=10
# controlled root for rendered content deliverables (keep under /var/lib/aios);
# blank -> falls back to AUDIT_ARTIFACT_DIR
CONTENT_ARTIFACT_DIR=/var/lib/aios/artifacts/content
CONTENT_PRECHECK_RESEARCH_CALLS=10
CONTENT_PRECHECK_WRITER_CALLS=14

# --- Off-page module (7B): DataForSEO backlinks + BrightLocal citations ------
# DataForSEO uses HTTP Basic (login + password). Login is not a secret.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
BRIGHTLOCAL_API_KEY=
WEB2_PUBLISH_COST_ESTIMATE=0.0
OFFPAGE_MONITOR_COST_ESTIMATE=0.05

# --- Reports (7D): the Google Sheets operational store ----------------------
# Full service-account credential JSON (carries a private key). Buffered in Redis
# until this lands.
GOOGLE_SHEETS_SA_JSON=

# --- Delivery (7F): transactional email (Resend) + Slack --------------------
# In-app notifications + alert rows persist without these; only the email/Slack
# legs are skipped until the keys arrive.
RESEND_API_KEY=
# The verified Resend sending identity (not a secret). SET THIS to a domain YOU
# have verified in Resend. The code default is a `mail.qanry.com` address - if you
# are not that agency, leaving this unset sends your mail from a domain you do not
# control, which Resend rejects and which is not yours to use in the first place.
RESEND_FROM_EMAIL=AIOS <notifications@example.com>

# The ONE inbox that receives client-portal alerts (a new client request, and
# similar staff-facing signals). LEAVE IT BLANK rather than guessing: an address
# belonging to someone outside this agency would silently receive your clients'
# notifications. Blank means those alerts are simply not sent.
ADMIN_NOTIFY_EMAIL=
# Slack incoming-webhook URL (embeds a token)
SLACK_WEBHOOK_URL=

# --- Backups (7G): pg_dump snapshots + guarded restore + optional B2 offsite -
# controlled root snapshots are written under (keep under /var/lib/aios so the
# worker's StateDirectory covers it); blank -> a run degrades to a 'failed' record
BACKUP_ARTIFACT_DIR=/var/lib/aios/backups
# pg_dump / pg_restore binaries (postgresql-16 installs them on PATH)
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
BACKUP_TIMEOUT_SECONDS=1800
# Backblaze B2 offsite (S3-compatible). KEY-GATED on the full triple; without all
# three the local snapshot still succeeds and only the offsite copy is skipped.
# key_id is a login-style id (not a secret); the application_key IS a secret.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# optional S3 endpoint override (region host)
B2_ENDPOINT_URL=

# --- Sentry (optional error reporting) -------------------------------------
# blank -> disabled. This one is in the silent class too: with no DSN the platform
# reports no errors and also does not report that it is not reporting them, so an
# operator who assumes it is on gets silence from a system that is failing.
SENTRY_DSN=

# ================ SETTINGS WHOSE ABSENCE DEGRADES SILENTLY ==================
# These are here for ONE reason: skipping them does not break anything visibly.
# There is no error, no 'degraded' badge, no log line - just a wrong answer, a dead
# link, a missing image or a weaker guarantee than you think you have. Each entry
# below states the exact failure you get by leaving it alone, so you can decide
# rather than discover.
#
# Settings ALREADY documented earlier in this file that belong to this same class:
#   JWT_ACCESS_TTL_SECONDS (a short TTL logs people out mid-work, no explanation)
#   TRUSTED_HOSTS          (missing 127.0.0.1 -> every dashboard call 400s)
#   IMAGE_GEN_MODEL        (a stale template value overrides the code default)
#   RESEND_FROM_EMAIL      (defaults to another agency's sending domain)
#   NEXT_PUBLIC_*          (build-time; a restart applies nothing, silently)
#   B2_KEY_ID / B2_APPLICATION_KEY / B2_BUCKET (a PARTIAL triple skips the offsite
#                           copy while local snapshots keep succeeding, so backups
#                           look healthy while nothing leaves the box)
#   SENTRY_DSN             (above)

# --- Absolute URL for server-hosted files loaded from a THIRD-PARTY page -----
# Generated content IMAGES are embedded in the pages published to a client's
# WordPress site. The browser rendering THAT site is not on your origin and carries
# no bearer token, so a relative `/api/v1/...` image URL resolves against the
# client's own domain and 404s. Blank is the default, and blank looks completely
# fine in the dashboard preview (same-origin, so relative works) - the breakage is
# only visible on the published page, to the client's visitors. Set it to your
# public API origin.
PUBLIC_FILE_BASE_URL=https://api.example.com

# --- Controlled root the generated content IMAGES are hosted from ------------
# The image API returns base64, never a hosted URL, so the bytes are written here
# and served read-only. Blank falls back to CONTENT_ARTIFACT_DIR/content-images
# (set above, so the fallback works) - but if NO artifact root is configured, image
# hosting is simply unavailable and each image is dropped as `content_image_failed`
# in the log while the page publishes successfully WITHOUT it. Keep it under
# /var/lib/aios so the worker's StateDirectory covers it.
CONTENT_IMAGE_DIR=/var/lib/aios/artifacts/content-images

# --- Where an emailed deep-link points ---------------------------------------
# Alert emails (a new client-portal request, and similar) embed a link into the
# dashboard. The code default is http://localhost:3000. The email SENDS - the send
# is a real success and is logged as one - and the recipient gets a link that dies
# on their machine. Set your real dashboard origin.
ADMIN_BASE_URL=https://app.example.com

# --- Where the Google OAuth callback returns the browser ---------------------
# GSC/GA4 connect flows finish by redirecting here. The code default is the bare
# path `/admin/settings`, which resolves against whatever origin served the
# callback - the API host - and 404s there. A bare path is correct in dev
# (same-origin proxy) and quietly wrong in this split-host deploy. Absolute URL.
#
# GOOGLE_OAUTH_CLIENT_ID / _SECRET / _REDIRECT_URI are deliberately NOT listed
# here: without them the sync HOLDS and says so, which is the loud class.
GOOGLE_OAUTH_RETURN_PATH=https://app.example.com/admin/settings

# --- IndexNow per-domain key derivation salt ---------------------------------
# The per-domain IndexNow key is sha256(salt:host). Blank falls back to a FIXED
# salt that is in the open-source tree, so every key this deploy uses is derivable
# by anyone with the repo - and submissions keep succeeding exactly as before, so
# nothing ever indicates the problem. Generate a random one and keep it:
#   python -c "import secrets;print(secrets.token_hex(32))"
INDEXNOW_KEY_SALT=

# --- Which email transport is actually used ----------------------------------
# EMAIL_PROVIDER selects the sender: resend | smtp | none. The failure mode this
# entry exists for: filling in the SMTP block below and forgetting to switch this
# off "resend" leaves every email leg OFF (keyless Resend degrades to in-app only),
# and the in-app notification still lands - so the platform looks like it notified
# people while no mail was ever sent. Set the provider you configured.
EMAIL_PROVIDER=resend
# SMTP transport (used only when EMAIL_PROVIDER=smtp). 587 -> STARTTLS,
# 465 -> implicit SSL. A blank SMTP_HOST/SMTP_FROM degrades the sender to None and
# the email leg is skipped. A blank SMTP_PASSWORD sends UNAUTHENTICATED (Gmail
# refuses; an open relay accepts, which is worse than refusing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# falls back to SMTP_USER when blank
SMTP_FROM=

# --- Firecrawl: render + screenshot for the site-design extractor ------------
# Before building a page for a client's site the platform reads that site's
# existing design. The plain HTTP fetcher returns a modern site's empty JS shell,
# so the analysis sees no evidence and the profile collapses to the dataclass
# DEFAULTS - a complete-looking design profile that analysed nothing, which then
# gets built against. Keyless is a supported configuration; it is in this section
# because the result is plausible rather than obviously absent.
FIRECRAWL_API_KEY=

# --- Agency-wide daily ceiling on PUBLIC free audits -------------------------
# The free-audit funnel is UNAUTHENTICATED, so per-IP limiting bounds one abuser
# and not a distributed one. This is the only bound on the platform's total daily
# exposure from that funnel. It is counted in Postgres (survives a cache flush) and
# fails closed. The default (200) is a number nobody chose for YOUR box - choose it.
PUBLIC_AUDIT_DAILY_CAP=200
