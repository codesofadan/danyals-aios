# AIOS backend environment.
# Copy this file to .env (which is gitignored) and fill in the values.
# Every value here is read by app/config.py. Optional values degrade gracefully in
# dev (the app still boots); required secrets are enforced only when APP_ENV=prod.
#
# FOOTGUN: python-dotenv treats an inline `# comment` on a BLANK-value line as the
# value itself (e.g. `SENTRY_DSN=   # off` sets SENTRY_DSN to "# off", not ""). So
# every key that ships blank keeps its comment on its OWN line ABOVE the key. Keys
# that ship with a real value may keep a trailing inline comment (dotenv strips it).

# --- App -------------------------------------------------------------------
APP_ENV=dev                              # dev | prod  (drives docs, CORS, log format, fail-fast)
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
API_CORS_ORIGINS=http://localhost:3000   # comma-separated origins allowed to call the API (the Next.js app)
TRUSTED_HOSTS=*                           # comma-separated allowed Host headers; * allows any (set real hosts in prod)
# Public origin the API is reachable at (e.g. https://app.qanry.com), used to build
# ABSOLUTE URLs for server-hosted files that load from a THIRD-PARTY context with no
# auth header - notably generated CONTENT IMAGES embedded in a published WordPress
# page. Blank -> a relative "/api/v1/..." URL (fine same-origin; SET this in prod so
# a WordPress-embedded image resolves). Keep its OWN-line comment (dotenv footgun).
PUBLIC_FILE_BASE_URL=

# --- Local Postgres (the data plane) ---------------------------------------
# Two DSNs against the self-hosted PostgreSQL 16 server, one per trust level.
# NOTE (dotenv footgun): every blank-value key keeps its comment on its OWN line
# ABOVE the key, never trailing an empty value.
#
# Authenticated-role DSN -> the per-request RLS connection pool (RLS applies).
# This same var also feeds db/migrations apply + the RLS gate.
# e.g. postgresql://authenticated:...@localhost:5432/aios
DATABASE_URL=
# service_role DSN -> the privileged pool (BYPASSRLS); server-only, never logged.
# e.g. postgresql://service_role:...@localhost:5432/aios
DATABASE_ADMIN_URL=

# --- Local auth (own EdDSA JWT) --------------------------------------------
# Login SIGNS an access token with the Ed25519 PRIVATE key; the API VERIFIES every
# token with the PUBLIC key (algorithm allow-list ["EdDSA"] only -> no alg-confusion).
# STORAGE: each PEM is stored as ONE double-quoted line with real newlines escaped
# as literal \n. config.jwt_{private,public}_key_pem restores the newlines in code
# (a no-op if the value already has them), so PyJWT gets valid multi-line PEM.
# Generate a keypair (writes the PRIVATE key hidden; prints only the PUBLIC key):
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey as E; from cryptography.hazmat.primitives import serialization as s; k=E.generate(); pr=k.private_bytes(s.Encoding.PEM,s.PrivateFormat.PKCS8,s.NoEncryption()).decode(); pu=k.public_key().public_bytes(s.Encoding.PEM,s.PublicFormat.SubjectPublicKeyInfo).decode(); print('JWT_PRIVATE_KEY=\"'+pr.replace(chr(10),'\\\\n')+'\"'); print('JWT_PUBLIC_KEY=\"'+pu.replace(chr(10),'\\\\n')+'\"')"
# API-only; keep off the frontend and out of logs. NEVER commit the real key.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace-me...\n-----END PRIVATE KEY-----\n"
# Ed25519 PEM public key (VERIFIES access tokens).
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...replace-me...\n-----END PUBLIC KEY-----\n"
LOCAL_JWT_ISSUER=aios                     # expected `iss` on our own EdDSA tokens
JWT_AUDIENCE=authenticated               # expected `aud` on our own EdDSA tokens
JWT_ACCESS_TTL_SECONDS=3600              # access-token lifetime (seconds)

# --- Seed owner (dev/test bootstrap ONLY) ----------------------------------
# `python -m app.cli.provision_owner` mints the first local OWNER from these so
# the app + integration tests have a login. Not a prod path; the password is a
# secret (never logged). Leave blank in prod.
SEED_OWNER_USERNAME=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=owner@local.aios
SEED_OWNER_NAME=AIOS Owner

# --- Vault (app-layer AES-256-GCM) -----------------------------------------
# base64-encoded 32-byte AES-256-GCM master key; held ONLY in env, NEVER in
# Postgres. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ROTATING this key requires RE-SEALING every existing secret (decrypt with the
# old key, re-encrypt with the new one, bump key_version) -- vault_keys.key_version
# supports staging that migration. Losing the key makes stored secrets unrecoverable.
VAULT_MASTER_KEY=

# --- Redis (app cache + readiness) -----------------------------------------
# Separate logical DBs: app cache on /0, Celery broker on /1, results on /2,
# so a cache flush can never wipe queued jobs.
REDIS_URL=redis://127.0.0.1:6379/0           # app cache + readiness ping + token revocation
                                              # (127.0.0.1, not localhost: macOS resolves
                                              #  localhost to ::1 first, where an IPv4-bound
                                              #  Redis refuses and auth checks time out)
#EXTENSION_ORIGINS=                           # chrome-extension://<32-char id> — the Citation
                                              #  Assistant's identity for the CORS allow-list;
                                              #  the side panel shows it, click-to-copy
#EXTENSION_PAIR_API_BASE=                     # where the extension pairs; blank = derived from
                                              #  each request's own host
CELERY_BROKER_URL=redis://localhost:6379/1    # Celery job queue
CELERY_RESULT_BACKEND=redis://localhost:6379/2 # Celery task results

# --- Audit engine (Module 01) ----------------------------------------------
# The SEO audit engine (../danyals-audit-system) is a SEPARATE Python product
# with its OWN dependencies (playwright, etc.). The worker invokes it as an
# external subprocess using ITS OWN interpreter - it is never imported into this
# venv. Leave these blank in dev: the unit suite mocks the subprocess, and the
# live integration test auto-skips when AUDIT_ENGINE_DIR is unset.
# repo root of danyals-audit-system (e.g. ../danyals-audit-system)
AUDIT_ENGINE_DIR=
# interpreter in that repo's venv (e.g. ../danyals-audit-system/.venv/Scripts/python.exe)
AUDIT_ENGINE_PYTHON=
AUDIT_TIMEOUT_SECONDS=1500               # worker-owned hard timeout per run (< Celery task_time_limit 1800)
AUDIT_MAX_PAGES=100                      # default crawl breadth (--max-pages)
AUDIT_PROFILE=general                    # engine --profile
AUDIT_PAID_COST_ESTIMATE=1.5             # engine reports no spend; a Paid run logs this via the cost path
# controlled root for stored report PDFs + findings.json (API + worker share it); blank = no downloads
AUDIT_ARTIFACT_DIR=
# Fiverr upsell link shown on the PUBLIC free-audit report (P6C); not a secret
FIVERR_UPSELL_URL=https://www.fiverr.com/iamdaani

# --- Context / AI-memory module (P6B) --------------------------------------
# The client-context module is key-gated like the audit engine: it builds and
# unit-tests NOW on deterministic fakes and ACTIVATES when these keys land. Leave
# them blank in dev - the compaction pipeline runs in 'degraded' mode (raw events
# appended, freshness watermark held) until they arrive. Install the SDKs with
# `pip install -e .[ai]`. NOTE (dotenv footgun): blank-value keys keep their
# comment on their OWN line ABOVE the key.
#
# Summarizer (Anthropic - Claude). Anthropic has NO embeddings API, so the
# Embedder below is a SEPARATE provider. Leave blank in dev; never commit a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SUMMARY=claude-haiku-4-5   # cheap default fold model
ANTHROPIC_MODEL_HEAVY=claude-sonnet-5      # heavier model for large folds
# Embedder (Anthropic has no embeddings API, so it is a SEPARATE provider).
# EMBEDDINGS_PROVIDER selects the impl:
#   voyage -> Voyage AI (default; voyage-3 -> 1024)
#   openai -> OpenAI /v1/embeddings (for a client with an OpenAI key but NO Voyage
#             key). Set EMBEDDINGS_PROVIDER=openai, EMBEDDINGS_API_KEY=<openai key>,
#             EMBEDDINGS_MODEL=text-embedding-3-small (OpenAI pins the output vector
#             to EMBEDDINGS_DIM, so leaving DIM=1024 truncates safely; set DIM=1536
#             for the model's native size). EMBEDDINGS_DIM MUST equal the Pinecone
#             index dimension AND the FakeEmbedder so real<->fake stay swappable.
EMBEDDINGS_PROVIDER=voyage
# provider API key (Voyage or OpenAI, per EMBEDDINGS_PROVIDER); server-only, never logged.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3
EMBEDDINGS_DIM=1024
# Vector store (Pinecone; namespaced per entity 'entity_type:entity_id'). The
# index dimension MUST equal EMBEDDINGS_DIM.
PINECONE_API_KEY=
# name of the Pinecone index (required to activate the real vector store)
PINECONE_INDEX=
# optional index host override (blank -> resolved by name)
PINECONE_HOST=
# Pipeline tuning: debounce window, bounded summary token budget, retrieval breadth.
CONTEXT_DEBOUNCE_SECONDS=30
CONTEXT_SUMMARY_TOKEN_BUDGET=1200
CONTEXT_TOPK=6
CONTEXT_SUMMARIZE_COST_ESTIMATE=0.02      # per-summarize spend logged via the cost path (P6B-4)
CONTEXT_EMBED_COST_ESTIMATE=0.001         # per-embed spend logged via the cost path (P6B-4)

# --- Firecrawl (site-design render + screenshot) ---------------------------
# POST /content/site-design analyzes the client's REAL site so a new page can MATCH
# it. A plain httpx GET returns a modern site's empty JS shell (no styles), so Claude
# saw no real design. Firecrawl RENDERS the page (JS + CSS) and returns clean markdown
# + a full-page SCREENSHOT, which Claude analyzes with VISION. Blank -> the endpoint
# DEGRADES to the plain-httpx fallback fetcher (no screenshot); never a crash. The key
# is server-only, never logged. NOTE (dotenv footgun): blank-value key keeps its
# comment on its OWN line ABOVE the key.
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev  # Firecrawl REST base
SITE_DESIGN_SCREENSHOT=true                    # request a screenshot for the Claude-vision analysis

# --- Content images (OpenAI-compatible image generation) --------------------
# The image model (gpt-image-2, and gpt-image-1 before it) ALWAYS returns base64
# (b64_json), never a hosted url, so the pipeline decodes the PNG and HOSTS it under
# CONTENT_IMAGE_DIR (filename = sha256(bytes)), then embeds the served URL. Blank
# IMAGE_GEN_API_KEY -> a keyless deploy uses the deterministic FakeImageGenerator (no
# real images). CONTENT_IMAGE_DIR blank -> falls back to
# <CONTENT_ARTIFACT_DIR>/content-images (else the audit root); with NO artifact root
# at all, a real base64 image degrades to skipped (never a crash). The served route is
# public + read-only: GET /api/v1/public/content-images/{name} (a WordPress-embedded
# <img> loads with no bearer token). Keep blank-value comments on their OWN line
# (dotenv footgun).
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2                # image model (provider-configurable)
CONTENT_IMAGE_DIR=                         # hosting root; blank -> under CONTENT_ARTIFACT_DIR/AUDIT_ARTIFACT_DIR

# --- Elementor-editable page output ----------------------------------------
# When true, the AIOS Publisher plugin push ALSO carries an Elementor widget TREE
# (`elementor_data`) + edit mode, so the published page opens FULLY EDITABLE
# (drag-and-drop) in Elementor. The flat HTML body is always sent too (the fallback
# for a non-Elementor site). Set false to publish flat HTML only.
CONTENT_ELEMENTOR_ENABLED=true

# --- Off-page: citation-builder module (7B-4) -------------------------------
# Direct-API citation submitters. Blank -> that engine is unconfigured; a
# directory routed to it HOLDS as 'blocked' rather than guessing. See
# docs/CITATIONS-WEB2-CREDENTIALS.md for how to obtain each one.
BING_PLACES_API_KEY=
FOURSQUARE_API_KEY=
# Self-hosted Playwright bot (bot_fillable / captcha_assisted directories).
# `pip install -e .[automation]` then `playwright install chromium` to activate.
CAPTCHA_SOLVER_PROVIDER=capsolver        # capsolver | capmonster
CAPTCHA_SOLVER_API_KEY=
CITATION_PROXY_URL=                      # http(s)://user:pass@host:port (optional)
CITATION_ARTIFACT_DIR=                   # where submission proof screenshots land
CITATION_API_COST_ESTIMATE=0.01
CITATION_BOT_COST_ESTIMATE=0.005
CITATION_CAPTCHA_COST_ESTIMATE=0.006
# Citation ACCOUNT-CREATION (signup + email verify). One CATCH-ALL mailbox: every
# address at CITATION_MAIL_DOMAIN lands in this INBOX, so each signup confirms via
# its own unique alias. Blank -> a `bot:signup` directory HOLDS as 'blocked'. FREE
# (IMAP polling costs nothing; no money-dial). Password is never logged.
CITATION_IMAP_HOST=                      # imap.example.com (IMAP-SSL)
CITATION_IMAP_PORT=993
CITATION_IMAP_USER=
CITATION_IMAP_PASSWORD=
CITATION_MAIL_DOMAIN=                     # catch-all domain, e.g. mail.qanry.com

# --- Indexing module (submit published/on-demand URLs to search engines) ----
# Both engines are FREE (no cost dial). Each is independently gated + degrade-safe:
# when off/unconfigured the submission service records a 'skipped' row, never a crash.
#   IndexNow (Bing/Yandex/Seznam/...): SETUP CAVEAT - a random per-DOMAIN key must be
#   published as a `<key>.txt` file at the client domain root (a one-time manual step per
#   domain). The key is derived STABLY as sha256(INDEXNOW_KEY_SALT : host); set the salt
#   in prod so the key is not derivable from open-source code. The exact key + the file
#   URL to host are given by integrations.indexnow.indexnow_key_for_host / key_location.
INDEXNOW_ENABLED=false
INDEXNOW_KEY_SALT=                       # seeds the stable per-domain IndexNow key (set in prod)
#   Google Indexing API: reuses GOOGLE_SHEETS_SA_JSON (below). SETUP CAVEAT - add the
#   service-account client_email as an OWNER of the target property in Search Console AND
#   enable the Indexing API in the GCP project, or Google returns 403 (recorded as error).
GOOGLE_INDEXING_ENABLED=false
# The Google service-account credential JSON, REUSED by both the SheetStore and the
# Google Indexing API. Blank -> both degrade (SheetStore held, indexing 'skipped').
GOOGLE_SHEETS_SA_JSON=

# --- Delivery layer: email provider (two-way notifications) ----------------
# The delivery layer (in-app notifications + staff alerts) also emails the counterpart
# on each event: admin->team (task assigned/reviewed), team->admin (submitted for
# review), admin->client (report/deliverable ready), client->admin (portal request).
# The email leg is OPTIONAL + degrade-safe: unconfigured -> the in-app row still lands,
# only the email is skipped (never a crash). EMAIL_PROVIDER selects the transport:
#   resend  -> the Resend HTTP API   (needs RESEND_API_KEY + RESEND_FROM_EMAIL)
#   smtp    -> stdlib smtplib        (needs SMTP_HOST + SMTP_FROM, and SMTP_USER/PASSWORD
#              for an authenticated relay such as Gmail; 587=STARTTLS, 465=SSL)
#   none    -> email legs off (in-app only)
EMAIL_PROVIDER=resend
# Resend (used when EMAIL_PROVIDER=resend):
RESEND_API_KEY=                          # Resend transactional-email API key (secret)
RESEND_FROM_EMAIL=AIOS <noreply@mail.qanry.com>   # a VERIFIED Resend sending address
# SMTP / Gmail (used when EMAIL_PROVIDER=smtp). For Gmail: enable 2FA on the account and
# create an APP PASSWORD (not the login password) - that is SMTP_PASSWORD.
SMTP_HOST=                               # e.g. smtp.gmail.com
SMTP_PORT=587                            # 587 STARTTLS (default) or 465 implicit SSL
SMTP_USER=                               # SMTP username (Gmail: the full address)
SMTP_PASSWORD=                           # SMTP password / Gmail app-password (secret)
SMTP_FROM=                               # From: header (blank -> falls back to SMTP_USER)
# Where fixed-recipient operator alerts (e.g. a new client portal request) are emailed,
# and the dashboard base URL used to build deep links inside those emails:
ADMIN_NOTIFY_EMAIL=business.zainsaeed@gmail.com
ADMIN_BASE_URL=http://localhost:3000
# Slack escalation for staff ALERTS (optional; blank -> Slack leg skipped):
SLACK_WEBHOOK_URL=

# --- Tuning ----------------------------------------------------------------
READINESS_TIMEOUT_SECONDS=3              # hard ceiling for each /health/ready dependency check

# --- Sentry (optional) -----------------------------------------------------
# leave blank to disable error reporting
SENTRY_DSN=
