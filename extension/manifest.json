{
  "manifest_version": 3,
  "name": "AIOS Extension",
  "version": "0.1.0",
  "description": "Two operator lanes: directory citations (fill a listing form from the canonical business profile) and Web 2.0 placements (publish an approved draft in your own account). Records what actually happened; never submits for you.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AIOS Extension"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
