# =============================================================================
# WEB 2.0 HOUSE CREDENTIALS  —  one JSON blob, one entry per platform.
# Set as a SINGLE env var (prod: the stack's WEB2_HOUSE_CREDENTIALS_JSON).
# The publisher (integrations/web2_credentials.build_publisher) reads these by name.
#
# WHY MOST ARE MANUAL: the platforms actively block automated signup (Write.as returns
# "Bot detected", Blogger needs a Google account, WordPress.com/Tumblr need a registered
# OAuth app, Medium's publish API is retired, Dreamwidth needs an invite code). So each
# account is created ONCE by hand (use the catch-all email catchall@mail.qanry.com for
# any verification), then its token is pasted below.
#
# ✅ = already provisioned + publishing today.   ✍️ = you create the account + paste the token.
# =============================================================================

WEB2_HOUSE_CREDENTIALS_JSON='{
  "Telegra.ph":   {"access_token": "SET"},                                    ✅ anonymous, live
  "dev.to":       {"api_key": "SET"},                                         ✅ live (rate-limited)
  "Mataroa":      {"api_key": "SET"},                                         ✅ live
  "Mastodon":     {"access_token": "SET", "instance_url": "https://mastodon.social"}, ✅ live
  "Micro.blog":   {"token": "SET"},                                           ✅ present (endpoint flaky)

  "WordPress.com":{"oauth_token": "", "site": "yourblog.wordpress.com"},      ✍️ create app at developer.wordpress.com/apps -> OAuth user token
  "Blogger":      {"oauth_token": "", "blog_id": ""},                         ✍️ Google account -> Blogger API OAuth token + blog id
  "Tumblr":       {"oauth_token": "", "blog": "yourblog.tumblr.com"},         ✍️ register app at tumblr.com/oauth/apps -> user token
  "Ghost":        {"admin_api_key": "", "api_url": "https://yourghost.ghost.io"}, ✍️ Ghost Admin -> Integrations -> Admin API key
  "GitHub Pages": {"token": "", "owner": "grillpublisher", "repo": "web2"},   ✍️ GitHub PAT with `contents:write` on the repo
  "GitLab Pages": {"token": "", "project_id": ""},                            ✍️ GitLab PAT with `api` scope + a project id
  "Hashnode":     {"pat": "", "publication_id": ""},                          ✍️ hashnode.com/settings/developer -> PAT + publication id
  "Hatena Blog":  {"hatena_id": "", "blog_id": "", "api_key": ""},            ✍️ Hatena account -> AtomPub API key
  "LiveJournal":  {"username": "", "password": ""},                           ✍️ signup (reCAPTCHA) -> username + password
  "Dreamwidth":   {"username": "", "password": ""},                           ✍️ needs an INVITE CODE to sign up
  "Write.as":     {"token": "", "alias": ""},                                 ✍️ signup blocks bots -> create by hand, then API token

  "Webflow":      {"api_token": "", "collection_id": "", "site": "", "url_path": "blog"}, ✍️ Project Settings -> Apps & Integrations -> API Access -> generate a site API token; collection_id from the CMS collection's settings panel
  "HubSpot CMS":  {"access_token": "", "content_group_id": ""},               ✍️ Settings -> Integrations -> Private Apps -> create one with `content` scope; content_group_id is the target blog's id
  "Drupal":       {"base_url": "", "username": "", "password": ""},          ✍️ create an API-only Drupal user (Basic-auth) with permission to create/edit content
  "Joomla":       {"base_url": "", "api_token": "", "catid": ""},             ✍️ Users -> Edit your user -> API Token tab -> generate; catid from the target category's edit URL

  "HackMD":       {"token": ""},                                             ✍️ hackmd.io -> Settings -> API -> generate a token
  "GitHub Gist":  {"token": ""},                                             ✍️ GitHub PAT with `gist` scope
  "GitLab Snippets": {"token": ""},                                          ✍️ GitLab PAT with `api` scope
  "paste.ee":     {"api_key": ""},                                           ✍️ paste.ee/account/api -> generate a key
  "Pastebin.com": {"api_dev_key": ""},                                       ✍️ pastebin.com/doc_api -> your account's api_dev_key
  "Netlify":      {"api_token": "", "site_id": ""},                          ✍️ user settings -> Applications -> Personal access tokens; site_id from an existing site
  "Neocities":    {"api_key": "", "sitename": ""},                           ✍️ Site Settings -> API key; sitename is your {sitename}.neocities.org subdomain
  "rentry.co":    {},                                                        ✅ fully anonymous, no credential at all
  "dpaste.org":   {},                                                        ✅ fully anonymous, no credential at all
  "Misskey":      {"token": "", "instance_url": "https://misskey.io"},       ✍️ Settings -> API -> generate an access token
  "Lemmy":        {"username": "", "password": "", "community": "", "base_url": "https://lemmy.world"}, ✍️ signup -> username/password; community is the target community's name
  "Bluesky":      {"identifier": "", "app_password": ""},                    ✍️ bsky.app/settings/app-passwords -> generate an App Password (NEVER the main password)
  "WhiteWind":    {"identifier": "", "app_password": ""},                    ✍️ reuses the SAME Bluesky account/App Password as above
  "Disqus":       {"access_token": "", "api_key": "", "username": ""},       ✍️ disqus.com/api/docs -> register an app for a public/secret key, OAuth2 for the access_token
  "Plurk":        {"consumer_key": "", "consumer_secret": "", "access_token": "", "access_token_secret": ""}, ✍️ plurk.com/PlurkApp -> register an OAuth1 app
  "Pixelfed":     {"access_token": "", "placeholder_image_url": "", "instance_url": "https://pixelfed.social"}, ✍️ register an app for a token; placeholder_image_url is a fixed brand image (Pixelfed requires an image per post)
  "Notion":       {"integration_token": "", "parent_page_id": ""},           ✍️ notion.so/my-integrations -> create an internal integration + share a parent page with it
  "Gravatar":     {"api_token": "", "username": ""},                         ✍️ Gravatar Developer Dashboard -> API key
  "Minds":        {"access_token": ""},                                     ✍️ Settings -> API -> personal access token

  "Sanity":       {"api_token": "", "project_id": "", "dataset": "production", "doc_type": "post"}, ✍️ sanity.io/manage -> project -> API -> Tokens (Editor role); dataset is usually "production"; doc_type must match the project's actual schema type
  "Storyblok":    {"token": "", "space_id": "", "component": "page"},      ✍️ app.storyblok.com -> space Settings -> Access Tokens -> Personal access token (Management API); component must match the space's actual content-type schema
  "Hygraph":      {"endpoint": "", "token": "", "model": "post"},          ✍️ app.hygraph.com -> project -> Settings -> API Access (Content API endpoint) + Permanent Auth Tokens; model must match an existing content model with title/slug/content fields
  "WriteFreely":  {"instance_url": "", "token": "", "target": ""},         ✍️ pick + verify one OPEN instance from writefreely.org/instances (e.g. Germany's text.tchncs.de), sign up by hand, then paste its URL; token/target optional - blank posts anonymously. Volunteer-run, no SLA - re-verify the instance is still open before relying on it

  "Zenodo":       {"access_token": "", "creator_name": "Editorial Team"},   ✍️ zenodo.org -> Applications -> Personal access tokens; creator_name is optional (defaults to "Editorial Team")
  "Internet Archive": {"access_key": "", "secret_key": "", "item_prefix": ""}, ✍️ archive.org/account/s3.php -> your S3-like keys; item_prefix (optional) namespaces your item ids (IA identifiers are GLOBAL, not per-account)
  "OSF":          {"access_token": ""},                                    ✍️ osf.io/settings/tokens -> generate a personal access token
  "Figshare":     {"access_token": ""},                                    ✍️ figshare.com/account/applications -> generate a personal token
  "Codeberg Pages": {"token": "", "owner": "", "repo": ""},                 ✍️ codeberg.org/user/settings/applications -> generate a token with repo scope
  "Livedoor Blog": {"livedoor_id": "", "blog_name": "", "api_key": ""},     ✍️ Livedoor Blog settings -> AtomPub section shows the API key (NOT the account password)
  "FC2 Blog":     {"blog_id": "", "username": "", "password": ""},         ✍️ FC2 Blog account credentials (legacy metaWeblog XML-RPC, no OAuth)
  "Seesaa Blog":  {"blog_id": "", "username": "", "password": ""},         ✍️ Seesaa Blog account credentials (same metaWeblog protocol as FC2)
  "Warpcast":     {"api_key": "", "signer_uuid": ""},                       ✍️ neynar.com dashboard -> API key; signer_uuid needs a one-time signer-approval handshake by the account owner
  "Sourcehut Pages": {"token": "", "domain": ""}                            ✍️ meta.sr.ht/oauth/personal-token -> a token with pages.sr.ht scope; domain is the target *.srht.site (or custom) domain
}'

# NOTE: the "✅/✍️" glyphs + trailing comments above are documentation only — the REAL
# value must be strict JSON (no comments, no glyphs). Fill the ✍️ tokens, strip the notes,
# and set the one-line JSON. Verification emails for any signup land in the catch-all:
#   IMAP imap.hostinger.com:993  ·  catchall@mail.qanry.com / Catchall@mail1
