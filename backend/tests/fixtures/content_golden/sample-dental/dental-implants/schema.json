      "@type": "FAQPage",
      "@id": "https://www.sunbridgedental.example/dental-implants/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do dental implants hurt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The placement is done under local anesthesia, with sedation available, so you should not feel pain during it. Afterward, most patients manage the soreness with over-the-counter pain relief and describe it as milder than the tooth problem that brought them in."
          }
        },
        {
          "@type": "Question",
          "name": "How long do dental implants last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The implant post is designed to be a long-term replacement, and survival rates in the dental research are high over many years. The crown on top can wear over time and may need replacement down the road. Good home care and regular checkups protect the investment."
          }
        },
        {
          "@type": "Question",
          "name": "Am I too old, or do I have too little bone, for implants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Age itself is rarely the barrier; health and bone are what matter. If your jawbone is thin, a bone graft or a sinus lift often makes implants possible. The only way to know your situation is the 3D scan at a consult."
          }
        },
        {
          "@type": "Question",
          "name": "Can I get all my teeth replaced in one day?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For a full arch, an All-on-4 approach can give you a fixed temporary set of teeth on the day of surgery in many cases. The final, permanent teeth are fitted after your implants have healed."
          }
        }
      ]
    }
